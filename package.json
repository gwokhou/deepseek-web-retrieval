{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "deepseek-web-retrieval",
  "version": "0.7.0",
  "description": "Token-efficient DeepSeek Search and Fetch for coding agents, starting with OpenCode v2.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwokhou/deepseek-web-retrieval.git"
  },
  "homepage": "https://github.com/gwokhou/deepseek-web-retrieval#readme",
  "bugs": "https://github.com/gwokhou/deepseek-web-retrieval/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pi",
    "pi-extension",
    "deepseek",
    "websearch",
    "webfetch",
    "coding-agent",
    "mcp"
  ],
  "exports": {
    ".": "./index.ts",
    "./core": "./src/core/index.ts",
    "./mcp": "./src/mcp/server.ts",
    "./pi": "./src/pi/extension.ts"
  },
  "pi": {
    "extensions": [
      "./src/pi/extension.ts"
    ]
  },
  "bin": {
    "deepseek-web-retrieval": "dist/cli.js"
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:ci": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/mcp/cli.ts --target=node --format=esm --outdir=dist --external @modelcontextprotocol/server --external @modelcontextprotocol/server/stdio --external zod --external zod/v4",
    "prepublishOnly": "bun run check:release",
    "test": "bun test",
    "test:package": "node scripts/test-package.mjs",
    "test:e2e:keyless": "bun run test:e2e pi pi-extension installer reinit upgrade pkg capability-off",
    "check:release": "bun run check && bun run test:package && bun run test:e2e:keyless",
    "test:e2e": "bun run test/e2e/run.ts",
    "docs:matrix": "bun run scripts/render-matrix.ts",
    "test:coverage": "bun test --coverage",
    "check": "bun run lint && bun run typecheck && bun run docs:matrix --check && bun run build && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@opencode/plugin": "^2.0.32"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@opencode/plugin": "2.0.32",
    "@types/bun": "1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "zod": "^4"
  }
}
