{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "deepseek-web-retrieval",
  "version": "0.1.0",
  "description": "Token-efficient DeepSeek Search and Fetch for coding agents, starting with OpenCode v2.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "deepseek",
    "websearch",
    "webfetch",
    "coding-agent",
    "mcp"
  ],
  "exports": {
    ".": "./index.ts",
    "./core": "./src/core/index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
