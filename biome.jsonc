{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  // Check source, tests (including the e2e harness), scripts, and project config.
  // Docs, examples, and the vendored e2e model catalog retain their own formatting.
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "index.ts",
      "package.json",
      "tsconfig.json",
      "biome.jsonc",
      "!!test/e2e/codex-models.json",
      "!!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "lineWidth": 120
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
