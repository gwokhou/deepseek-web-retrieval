{
  // Single source of truth for the host compatibility matrix. Machine consumers:
  // scripts/render-matrix.ts (regenerates the host table in docs/integration.md and the
  // control matrix in docs/research/control-matrix.md via `bun run docs:matrix`),
  // scripts/ci-matrix.ts (GitHub Actions matrix),
  // test/e2e/run.ts (Docker build args), and test/hosts.test.ts (invariants).
  // Narrative docs reference this file; they must not restate these facts.
  //
  // Mechanism ids in "paths" align with the Mechanisms table in
  // docs/integration.md: native-provider, native-override, plugin, extension,
  // mcp, wrapper. "paths" is ordered: the first entry is the recommended path.
  // "control" aligns with docs/research/control-matrix.md: per capability, the optional/
  // preferred tiers ("yes" or structurally "n/a") and the forced tier —
  // "replacement" (swap the built-in implementation), "exclusion" (disable or
  // deny the built-in competitor), "de-facto" (no built-in competitor), or
  // "none" — plus the config key that realizes it.
  // Version mentions inside `key` strings and per-host prose are research-provenance
  // anchors verified at the locked version, not lock restatements; re-verify them
  // whenever "baseline" or a host "version" changes (docs/research/control-matrix.md
  // tracks the known drift points).
  // Rows render in file order — keep open-source hosts first, then alphabetical.
  "baseline": "2026-10-19",
  "hosts": [
    {
      "name": "cline",
      "display": "Cline",
      "version": "0.0.13",
      "license": "Apache-2.0",
      "npm": "@cline/cli",
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp", "plugin"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "de-facto", "key": "no built-in web-search tool at 0.0.13 (binary-verified)" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`disabledTools` in `~/.cline/data/settings/global-settings.json`" }
      },
    },
    {
      "name": "codex",
      "display": "Codex",
      "version": "0.163.0",
      "license": "Apache-2.0",
      "npm": "@openai/codex",
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`web_search = \"disabled\"` (top-level config.toml)" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "de-facto", "key": "no built-in fetch tool at 0.163.0" }
      },
    },
    {
      "name": "continue",
      "display": "Continue",
      "version": "1.5.47",
      "license": "Apache-2.0",
      "npm": "@continuedev/cli",
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "de-facto", "key": "no `search_web` in the CLI at 1.5.47 (IDE extension only)" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`--exclude Fetch` / permissions.yaml `exclude`" }
      },
    },
    {
      "name": "gemini",
      "display": "Gemini",
      "version": "0.64.0",
      "license": "Apache-2.0",
      "npm": "@google/gemini-cli",
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`tools.exclude` / `tools.core` in settings.json" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`tools.exclude` / `tools.core` in settings.json" }
      },
    },
    {
      "name": "opencode",
      "display": "OpenCode",
      "version": "2.0.32",
      "license": "MIT",
      "npm": "@opencode/cli",
      "nativeSearchProvider": true,
      "nativeFetchOverride": true,
      "paths": ["native-provider", "native-override"],
      "status": "supported",
      "control": {
        "search": { "optional": "n/a", "preferred": "n/a", "forced": "replacement", "key": "`websearch.provider: \"deepseek\"` or plugin `setDefaultWebsearch`" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "replacement", "key": "`fetchOverrideWebfetch: true`" }
      },
      "adapter": "src/opencode",
      "guide": "docs/agents/opencode-v2.md",
      "e2eScenario": "opencode"
    },
    {
      "name": "pi",
      "display": "Pi",
      "version": "1.3.0",
      "license": "MIT",
      "npm": "@earendil-works/pi-coding-agent",
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp", "extension"],
      "status": "supported",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "de-facto", "key": "no built-in web tool at 1.3.0 (source-verified)" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "de-facto", "key": "no built-in web tool at 1.3.0 (source-verified)" }
      },
      "adapter": "src/mcp",
      "guide": "docs/agents/pi.md",
      "e2eScenario": "pi"
    },
    {
      "name": "claude-code",
      "display": "Claude Code",
      "version": "2.1.303",
      "license": null,
      "npm": "@anthropic-ai/claude-code",
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`permissions.deny: [\"WebSearch\"]` removes the tool from context" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`permissions.deny: [\"WebFetch\"]`, or `CLAUDE_CODE_DISABLE_WEB_FETCH=1`" }
      },
    },
    {
      "name": "cursor",
      "display": "Cursor",
      "version": "2026.10.08",
      "license": null,
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "none", "key": "" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`permissions.deny: [\"WebFetch(*)\"]`" }
      },
    },
    {
      "name": "devin",
      "display": "Devin",
      "version": "3000.11.92",
      "license": null,
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`disabled_tools` / `permissions.deny` in config.json" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`disabled_tools` / `permissions.deny` in config.json" }
      },
    },
    {
      "name": "github-copilot",
      "display": "GitHub Copilot",
      "version": "1.0.98",
      "license": null,
      "npm": "@github/copilot",
      "nativeSearchProvider": false,
      "nativeFetchOverride": false,
      "paths": ["mcp"],
      "status": "no-adapter-yet",
      "control": {
        "search": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`githubMcpTools` settings (competitor ships via the bundled GitHub MCP server)" },
        "fetch": { "optional": "yes", "preferred": "yes", "forced": "exclusion", "key": "`--deny-tool web_fetch` / `--excluded-tools` (session flags)" }
      },
    }
  ]
}
