{
  // Single source of truth for the host compatibility matrix. Machine consumers:
  // scripts/render-matrix.ts (regenerates the table in docs/integration.md via
  // `bun run docs:matrix`), scripts/ci-matrix.ts (GitHub Actions matrix),
  // test/e2e/run.ts (Docker build args), and test/hosts.test.ts (invariants).
  // Narrative docs reference this file; they must not restate these facts.
  //
  // Mechanism ids in "paths" align with the Mechanisms table in
  // docs/integration.md: native-provider, native-override, plugin, extension,
  // mcp, wrapper. "paths" is ordered: the first entry is the recommended path.
  // Rows render in file order — keep open-source hosts first, then alphabetical.
  "baseline": "2026-10-19",
  "hosts": [
